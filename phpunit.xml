<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

        <!--
          Tests run against a real PostgreSQL database (lms_test), NOT SQLite.

          This is deliberate and non-negotiable (architecture.md C-03). From
          Phase 3 onwards the schema depends on PostgreSQL-specific behaviour
          that SQLite does not implement:
            - JSONB columns
            - PARTIAL unique indexes (one in-progress attempt per student)
            - CHECK constraints mirroring PHP enums
            - timestamptz semantics
          Testing on SQLite would pass while the production schema was broken,
          which is worse than not testing at all.

          DB_DATABASE is intentionally hard-coded to lms_test so a mistaken
          .env value can never point the suite at the development database and
          wipe it via RefreshDatabase.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="lms_test"/>
        <env name="DB_URL" value=""/>

        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>

        <!--
          The suite always tests against the LOCAL content disk, whatever the
          developer's .env says.

          Same reasoning as DB_DATABASE above, and found the same way: pointing
          LMS_CONTENT_DISK at S3/Backblaze to try cloud storage locally turned
          two tests red — one asserting uploads land on `content`, one
          asserting that disk is private — and neither was a real regression.

          The worse half is what would happen if they had not failed: the suite
          would upload test fixtures to a REAL bucket on every run, costing
          money, taking network time, and leaving debris in the same bucket
          that serves students.

          Cloud storage is verified deliberately, not incidentally by every
          developer who happens to have credentials in .env.
        -->
        <env name="LMS_CONTENT_DISK" value="content" force="true"/>

        <!--
          Mail previews are OFF for the suite, pinned here rather than left to
          the ambient environment.

          .env.example enables them (they are development tooling), and CI
          builds its .env from .env.example — so without this the suite
          inherits whatever the environment happens to say. MailSafetyTest
          asserts the routes are ABSENT when disabled, and that assertion is
          meaningless if the flag is not controlled.

          Found by CI, not locally: a developer .env predating this variable
          leaves previews off by default, so the tests passed on the machine
          that wrote them and failed on the machine that copied .env.example.
          The same class of bug as the withoutVite() note in tests/TestCase.php.

          MailPreviewTest turns the flag back on per-test and registers the
          routes itself, so both sides stay covered.

          force="true" so this wins over a value coming from .env, which is the
          case that actually broke CI.

          LIMIT, stated honestly: a variable EXPORTED IN THE SHELL still wins,
          because config/lms.php reads it through env() before this applies.
          Running `LMS_MAIL_PREVIEW_ENABLED=true vendor/bin/pest` will fail
          these three tests. Nothing does that — CI sets the value via .env,
          not the shell — and the first test below asserts the precondition, so
          the failure is immediate and self-explaining rather than silent.
        -->
        <env name="LMS_MAIL_PREVIEW_ENABLED" value="false" force="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
