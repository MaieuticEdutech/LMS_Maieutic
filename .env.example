##
## LMS — environment template
##
## RULES (planning.md §11):
##  E-1  Every variable appears here with an EMPTY or safe placeholder value — never a real value.
##  E-2  .env is never committed, never shared, never logged.
##  E-3  env() is called only inside config/. Application code reads config().
##  E-8  Organisation-level SETTINGS (name, logo, thresholds) belong in the `settings`
##       database table, NOT here. Only infrastructure credentials and environment-specific
##       endpoints belong in .env.
##
## Copy to .env and fill in locally:  cp .env.example .env && php artisan key:generate
##

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

# Cost factor for password hashing. Tune at deployment.
BCRYPT_ROUNDS=12

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (PostgreSQL 16+ — architecture.md C-03) ─────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lms_dev
DB_USERNAME=
DB_PASSWORD=

# Separate database used by the test suite (phpunit.xml overrides DB_DATABASE with this).
DB_TEST_DATABASE=lms_test

# ─── Session / Cache / Queue ──────────────────────────────────────────────────
# Development uses the database driver. Production uses redis (architecture.md §22).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ─────────────────────────────────────────────────────────────────────
# FR-MAIL-09: development MUST use a non-delivering driver (log / Mailpit).
# A live transport must never be reachable from a developer machine.
# Production provider is selected in Phase 16 (PD-07) and requires SPF/DKIM/DMARC.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@lms.test"
MAIL_FROM_NAME="${APP_NAME}"

# Renders each transactional email at /dev/mail without triggering its flow.
# DEVELOPMENT ONLY — the routes are not registered when APP_ENV=production.
LMS_MAIL_PREVIEW_ENABLED=true

# SendMailJob retry policy (architecture.md §13: 3 tries, 60s backoff).
# LMS_MAIL_TIMEOUT must stay below the queue's retry_after (90s), or a slow
# send can be handed to a second worker and the recipient gets it twice.
LMS_MAIL_TRIES=3
LMS_MAIL_TIMEOUT=30

# ─── Object storage (S3-compatible, production — architecture.md §15.1) ───────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── LMS application configuration (config/lms.php) ───────────────────────────
# Disk holding protected learning content. NEVER a publicly served disk.
#   local (dev) -> storage/app/content   |   s3 (prod) -> private bucket
LMS_CONTENT_DISK=content

# Lifetime in seconds of a signed media URL. NFR-SEC-22: must stay <= 300.
LMS_MEDIA_URL_TTL=300

# Percentage of a video that must be watched before it auto-completes (FR-PROG-03).
LMS_VIDEO_COMPLETION_THRESHOLD=90

# Account activation link lifetime, in minutes (FR-AUTH-06, default 72h).
LMS_ACTIVATION_LINK_TTL=4320

# Password reset link lifetime, in minutes (FR-AUTH-06).
LMS_PASSWORD_RESET_TTL=60

# Identity of the first administrator, created by SuperAdminSeeder.
# Outside local/testing the seeder sets NO usable password and leaves the
# account pending activation — the operator takes control via "Forgot
# password". This is deliberate: a seeded default credential in production is
# an open door.
LMS_SUPER_ADMIN_EMAIL=
LMS_SUPER_ADMIN_NAME=

# ─── Payments — Razorpay (Phase 12, FR-PAY-15) ────────────────────────────────
# SECRETS. Never commit real values. Test-mode credentials only outside production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
